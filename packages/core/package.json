{
  "name": "trendcraft",
  "version": "0.6.1",
  "description": "Technical analysis library for TypeScript — 130+ indicators, backtesting, optimization, streaming, and zero dependencies",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "bin": {
    "trendcraft-screen": "./dist/bin/trendcraft-screen.js",
    "trendcraft-backtest": "./dist/bin/trendcraft-backtest.js",
    "trendcraft-analyze": "./dist/bin/trendcraft-analyze.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./screening": {
      "import": {
        "types": "./dist/screening/index.d.mts",
        "default": "./dist/screening/index.js"
      },
      "require": {
        "types": "./dist/screening/index.d.cts",
        "default": "./dist/screening/index.cjs"
      }
    },
    "./incremental": {
      "import": {
        "types": "./dist/indicators/incremental/index.d.mts",
        "default": "./dist/indicators/incremental/index.js"
      },
      "require": {
        "types": "./dist/indicators/incremental/index.d.cts",
        "default": "./dist/indicators/incremental/index.cjs"
      }
    },
    "./safe": {
      "import": {
        "types": "./dist/indicators/safe/index.d.mts",
        "default": "./dist/indicators/safe/index.js"
      },
      "require": {
        "types": "./dist/indicators/safe/index.d.cts",
        "default": "./dist/indicators/safe/index.cjs"
      }
    },
    "./manifest": {
      "import": {
        "types": "./dist/manifest/index.d.mts",
        "default": "./dist/manifest/index.js"
      },
      "require": {
        "types": "./dist/manifest/index.d.cts",
        "default": "./dist/manifest/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.d.*ts",
    "!dist/__benchmarks__",
    "!dist/**/*.js.map",
    "!dist/**/*.cjs.map",
    "!dist/**/*.d.*ts.map",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json && tsc -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "analyze": "tsx bin/trendcraft-analyze.ts",
    "test:crossval": "vitest run cross-validation",
    "bench": "vitest bench --reporter=verbose",
    "size": "size-limit",
    "qa:indicators": "node scripts/qa-sweep.mjs",
    "verify:publish": "node scripts/verify-publish.mjs",
    "prepublishOnly": "pnpm build && pnpm test && pnpm verify:publish"
  },
  "keywords": [
    "trading",
    "technical-analysis",
    "indicators",
    "backtesting",
    "optimization",
    "streaming",
    "sma",
    "ema",
    "rsi",
    "macd",
    "bollinger-bands",
    "ichimoku",
    "vwap",
    "smart-money",
    "screening",
    "finance",
    "stocks",
    "crypto"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sawapi/trendcraft.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/sawapi/trendcraft#readme",
  "bugs": {
    "url": "https://github.com/sawapi/trendcraft/issues"
  },
  "author": "sawapi",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "name": "import { sma } from \"trendcraft\"",
      "path": "dist/index.js",
      "import": "{ sma }",
      "limit": "2 kB"
    },
    {
      "name": "import { runBacktest, goldenCross } from \"trendcraft\"",
      "path": "dist/index.js",
      "import": "{ runBacktest, goldenCross }",
      "limit": "15 kB"
    },
    {
      "path": "dist/index.js",
      "limit": "180 kB"
    },
    {
      "path": "dist/index.cjs",
      "limit": "195 kB"
    }
  ],
  "devDependencies": {
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "size-limit": "^14.3.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
