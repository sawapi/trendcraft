{
  "name": "trendcraft-chart-screenshots",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Internal playground for generating screenshots used in docs/assets/.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "capture": "bash ./capture.sh",
    "fetch-data": "tsx fetch-data.ts"
  },
  "dependencies": {
    "@trendcraft/chart": "link:../..",
    "trendcraft": "link:../../../core"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "packageManager": "pnpm@10.34.7"
}
