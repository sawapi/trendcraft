{
  "name": "@trendcraft/chart",
  "version": "0.5.0",
  "description": "Zero-dependency Canvas charting for TypeScript — candlestick & financial charts that work on plain OHLC data, with React/Vue wrappers and a headless API. Auto-places TrendCraft indicators when paired.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "require": "./dist/headless.cjs"
    },
    "./sparkline": {
      "types": "./dist/sparkline.d.ts",
      "import": "./dist/sparkline.js",
      "require": "./dist/sparkline.cjs"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "import": "./dist/replay.js",
      "require": "./dist/replay.cjs"
    },
    "./features": {
      "types": "./dist/features.d.ts",
      "import": "./dist/features.js",
      "require": "./dist/features.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./react/sparkline": {
      "types": "./dist/react/sparkline.d.ts",
      "import": "./dist/react/sparkline.js",
      "require": "./dist/react/sparkline.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs"
    },
    "./vue/sparkline": {
      "types": "./dist/vue/sparkline.d.ts",
      "import": "./dist/vue/sparkline.js",
      "require": "./dist/vue/sparkline.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*",
    "!dist/**/*.js.map",
    "!dist/**/*.cjs.map",
    "!dist/**/*.d.ts.map",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "size-check": "size-limit",
    "format": "biome format --write .",
    "verify:publish": "node scripts/verify-publish.mjs",
    "gen:llms": "node scripts/gen-llms-full.mjs",
    "prepublishOnly": "pnpm build && pnpm test && pnpm verify:publish"
  },
  "keywords": [
    "charting-library",
    "candlestick",
    "financial-charts",
    "stock-chart",
    "ohlc",
    "typescript",
    "canvas",
    "react-chart",
    "vue-chart",
    "realtime",
    "technical-analysis",
    "headless",
    "sparkline",
    "trendcraft"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sawapi/trendcraft.git",
    "directory": "packages/chart"
  },
  "bugs": {
    "url": "https://github.com/sawapi/trendcraft/issues"
  },
  "homepage": "https://github.com/sawapi/trendcraft/tree/main/packages/chart#readme",
  "author": "sawapi",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "trendcraft": ">=0.3.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "trendcraft": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "Main (createChart + all exports)",
      "path": "dist/index.js",
      "limit": "44.5 kB"
    },
    {
      "name": "Headless API",
      "path": "dist/headless.js",
      "limit": "12.5 kB"
    },
    {
      "name": "Sparkline (vanilla)",
      "path": "dist/sparkline.js",
      "limit": "5 kB"
    },
    {
      "name": "Replay (live simulator)",
      "path": "dist/replay.js",
      "limit": "3 kB"
    },
    {
      "name": "Features (all)",
      "path": "dist/features.js",
      "limit": "6.25 kB"
    },
    {
      "name": "Sparkline (React)",
      "path": "dist/react/sparkline.js",
      "limit": "7 kB"
    },
    {
      "name": "Sparkline (Vue)",
      "path": "dist/vue/sparkline.js",
      "limit": "7 kB"
    },
    {
      "name": "React wrapper",
      "path": "dist/react/TrendChart.js",
      "limit": "36.5 kB"
    },
    {
      "name": "Vue wrapper",
      "path": "dist/vue/TrendChart.js",
      "limit": "36.5 kB"
    }
  ],
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "trendcraft": "workspace:*",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
